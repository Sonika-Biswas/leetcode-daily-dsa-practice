class Solution {
public:
    bool isPalindrome(int x) {
        if(x<0){
            return false;
        }
        int d;
        int rev=0;
        int copy=x;
        while(x>0){
            if(rev>INT_MAX/10 || rev<INT_MIN/10){
                return false;
            }
            d=x%10;
            rev=(rev*10) + d;
            x=x/10;
        }
        if(rev==copy){
            return true;
        }
        else{
            return false;
        }
    }
};
