#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin >> n;
    int arr[n];
    for(int i=0; i<n; i++){
        cin >> arr[i];
    }
    int didSwap=0; // Bubble Sort Optimized
    for(int i=n-1; i>=0; i--){
        for(int j=0; j<=i-1; j++){
            if(arr[j]>arr[j+1]){
                int temp=arr[j];
                arr[j]=arr[j+1];
                arr[j+1]=temp;
                didSwap=1;
            }
        }
        if(didSwap==0){ //the time complexity of bubble sort is O(n^2) but if the array is already sorted then we can use didSwap to check if there has been any swaps in the first full scanning of the array using the innerloop....if not then we can break from the outer loop and the time complexity is O(n)
            break;
        }
    }
    for(int i=0; i<n; i++){
        cout << arr[i] << " "<< endl;
    }
}
