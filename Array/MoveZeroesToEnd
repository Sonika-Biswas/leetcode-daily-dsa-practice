#include<bits/stdc++.h>
using namespace std;
void moveZeroes(vector<int>& nums) {
    int j=-1;
    for(int i=0; i<=nums.size()-1; i++){
        if(nums[i]==0){
            j=i;
            break;
            }
    }
    if(j==-1){
        return;
    }
    for(int i=j+1; i<=nums.size()-1; i++){
        if(nums[i]!=0){
            swap(nums[i],nums[j]);
            j++;
        }
    }
    for(int i=0; i<=nums.size()-1; i++){
        cout << nums[i] << " ";
    }
    }
int main(){
    int size;
    cin >> size;
    vector<int> nums(size);
    for(int i=0; i<size; i++){
        cin >> nums[i];
    }
    moveZeroes(nums);
}
