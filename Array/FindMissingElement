#include<bits/stdc++.h>
using namespace std;
int main(){
    int n;
    cin >> n;
    int arr[n-1];
    cout << "Enter n-1 distinct vales";
    for(int i=0; i<n-1; i++){
        cin >> arr[i];
    }
    int j=1;
    int flag=0;
    for(int i=0; i<n-1; i++){
        if(arr[i]!=j){
            cout << "Missing element is:" << j << endl;
            flag=1;
            break;
        }
        else{
            j++;
        }
    }
    if(flag==0){
        cout << "Missing element is:" << n << endl;
    }
}

//Time Complexity O(n)
//Space Complexity O(1)
