#include<bits/stdc++.h>
using namespace std;
int main(){
    int sizearr;
    cin >> sizearr;
    vector <int> arr(sizearr);
    for(int i=0; i<sizearr; i++){
        cin >> arr[i];
    }
    int maxi=0;
    int count=0;
    for(int i=0; i<sizearr; i++){
        if(arr[i]==1){
            count++;
            maxi=max(maxi,count);
        }
        else{
            count=0;
        }
    }
    cout << "Maximum number of consecutive 1's: " << maxi << endl;
}
//Time Complexity O(n)
//Space Complexity O(1)
