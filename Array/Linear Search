#include<bits/stdc++.h>
using namespace std;
int main(){
    int size;
    cin >> size;
    vector<int> arr(size);
    for(int i=0; i<size; i++){
        cin >> arr[i];
    }
    int ele;
    cout << "Enter element to search" << endl;
    cin >> ele;
    int flag=0;
    for(int i=0; i<size; i++){
        if(arr[i]==ele){
            cout << "Element at index " << i << endl;
            flag=1;
            break;
        }
    }
    if(flag==0){
        cout << "Element not found";
    }
}
//Time Complexity O(n)
//Space Complexity O(1)
