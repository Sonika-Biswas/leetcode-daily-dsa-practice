#include<bits/stdc++.h>
using namespace std;
int main(){
    int size;
    cin >> size;
    vector <int> arr(size);
    for(int i=0; i<size; i++){
        cin >> arr[i];
    }
    int xorr=0;
    for(int i=0; i<size; i++){
        xorr=xorr^arr[i];
    }
    cout << xorr;
}

//Time Complexity O(n)
//Space Complexity O(1)
