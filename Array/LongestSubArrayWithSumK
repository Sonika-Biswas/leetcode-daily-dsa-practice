#include<bits/stdc++.h>
using namespace std;
int main(){
    int size;
    cin >> size;
    int k;
    cin >> k;
    int arr[size];
    for(int i=0; i<size; i++){
        cin >> arr[i];
    }
    map <long long,int> preSumMap;
    long long sum=0;
    int maxlen=0;
    int len=0;
    for(int i=0; i<size; i++){
        sum+=arr[i];
        if(sum==k){
            maxlen=max(maxlen, i+1);
        }
        int rem=sum-k;
        if(preSumMap.find(rem)!=preSumMap.end()){
            len=i-preSumMap[rem];
            maxlen=max(maxlen, len);
        }
        if(preSumMap.find(sum)==preSumMap.end()){
            preSumMap[sum]=i;
        }
    }
    cout << maxlen;
}
//Time Complexity O(n)
//Space Complexity O(n)
